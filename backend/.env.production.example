# ---------------------------------------------------------------------------
# MLC API — production environment template (Render)
# Copy the values into the Render dashboard (Environment → Environment Variables)
# or into render.yaml. NEVER commit a real .env.
# ---------------------------------------------------------------------------

APP_NAME=MLC
APP_ENV=production
APP_DEBUG=false

# Generate with:  php artisan key:generate --show   (run inside backend/)
APP_KEY=

# The Render service URL (shown on the service page, e.g. https://mlc-api.onrender.com)
APP_URL=https://YOUR-SERVICE.onrender.com

# The Vercel storefront origin — used for CORS, Google OAuth redirect and email links
FRONTEND_URL=https://YOUR-APP.vercel.app

# Extra CORS origins, comma-separated (optional — e.g. Vercel preview domains)
# CORS_ALLOWED_ORIGINS=
# CORS_ALLOWED_ORIGINS_PATTERNS=#^https://mlc-shop.*\.vercel\.app$#

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Logs stream to the Render dashboard
LOG_CHANNEL=stderr
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Supabase Postgres
# Prefer the "Session pooler" connection string from Supabase (Connect → Session pooler)
# if the direct host fails from Render (IPv6), otherwise use the direct host.
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.YOUR-PROJECT-REF
DB_PASSWORD=YOUR-DATABASE-PASSWORD
DB_SSLMODE=require
DB_PERSISTENT=true

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Email sending is synchronous in this app — no worker needed.
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ---------------------------------------------------------------------------
# Mailgun (set MAIL_MAILER=mailgun in production; keep "log" only for testing —
# emails then go to the Render logs instead of inboxes)
# ---------------------------------------------------------------------------
MAIL_MAILER=log
# MAIL_MAILER=mailgun
# MAILGUN_DOMAIN=mg.yourdomain.com
# MAILGUN_SECRET=key-XXXXXXXXXXXXXXXX
# MAILGUN_ENDPOINT=default
MAIL_FROM_ADDRESS="no-reply@mg.yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Google sign-in — add BOTH redirect URIs in Google Cloud Console
# (APIs & Services → Credentials → your OAuth client → Authorized redirect URIs):
#   http://localhost:8000/api/auth/google/callback          (local dev)
#   https://YOUR-SERVICE.onrender.com/api/auth/google/callback (production)
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
# GOOGLE_REDIRECT_URI=https://YOUR-SERVICE.onrender.com/api/auth/google/callback

# One-off seed: set to "true" for a single deploy (seeds categories, brands,
# 33 products, reviews, demo user), then set back to "false".
RUN_SEED=false
