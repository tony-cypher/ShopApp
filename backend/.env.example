APP_NAME=MLC
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Where the React app runs — used for links inside confirmation emails
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local default: SQLite (works out of the box).
DB_CONNECTION=sqlite

# ---------------------------------------------------------------------------
# Supabase Postgres (project settings -> Database -> Connection string)
# Switch DB_CONNECTION to "pgsql" and fill the five values below.
# ---------------------------------------------------------------------------
# DB_CONNECTION=pgsql
# DB_HOST=db.YOUR-PROJECT-REF.supabase.co
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=YOUR-DATABASE-PASSWORD
# DB_SSLMODE=require
# DB_PERSISTENT=true
# DB_URL=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Development: emails are written to laravel.log instead of being sent.
MAIL_MAILER=log

# ---------------------------------------------------------------------------
# Mailgun (site -> Sending -> Domain names / API security)
# Set MAIL_MAILER=mailgun and fill the three values below.
# ---------------------------------------------------------------------------
# MAIL_MAILER=mailgun
# MAILGUN_DOMAIN=mg.yourdomain.com
# MAILGUN_SECRET=key-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# MAILGUN_ENDPOINT=default        # use api.eu.mailgun.net for EU accounts

# ---------------------------------------------------------------------------
# Google sign-in (console.cloud.google.com -> APIs & Services -> Credentials)
# Create an OAuth client ID of type "Web application" with:
#   Authorized redirect URI: http://localhost:8000/api/auth/google/callback
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxx
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# With Mailgun this must be an address on your verified sending domain
MAIL_FROM_ADDRESS="no-reply@mg.yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
